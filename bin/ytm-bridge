#!/usr/bin/env python3
"""ytm-bridge: the link between the Omarchy shell and a YouTube Music window.

Attaches to the Chromium app window that bin/ytm-app launched (via the
DevTools port Chromium writes into the dedicated profile), and serves a
JSON-lines protocol on a private unix socket. Every authenticated request is
executed *inside the page* by the site's own session; this process never sees
a cookie or a token, only the JSON that comes back.

    ytm-bridge [--socket PATH] [--profile DIR] [--launcher PATH]   daemon
    ytm-bridge --once OP [JSON]                                    one request, print, exit
    ytm-bridge --check-id ID                                       grammar check, exit 0/1

Standard library only. Python 3.9+.
"""
import argparse
import base64
import json
import os
import queue
import re
import secrets
import signal
import socket
import struct
import subprocess
import sys
import threading
import time
import urllib.request

# Ids that may appear in a URL or be handed to the page. Same grammar as
# Ytm.isValidId in Ytm.js; tests/test-id-grammar.sh keeps them identical.
VALID_ID = re.compile(r"^[A-Za-z0-9_-]{2,64}$")
MAX_QUERY = 200
PAGE_URL_PREFIX = "https://music.youtube.com"
WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

# Everything read from the browser endpoint is bounded, because what comes
# back is shaped by the remote page. Measured on a live account 2026-09-20:
# the largest CDP reply is `home` (3 pages) at 1.35 MB on the wire, then a
# 10-page `playlist.items` at 1.08 MB. Anything past these caps is not a
# bigger answer, it is a broken or hostile peer, and the connection is
# closed rather than buffered.
MAX_HANDSHAKE = 16 * 1024          # HTTP 101 response, headers included
MAX_FRAME = 16 * 1024 * 1024       # one WebSocket frame's declared length
MAX_MESSAGE = 16 * 1024 * 1024     # a fragmented message, all pieces together
MAX_VERSION_JSON = 64 * 1024       # GET /json/version body

HERE = os.path.dirname(os.path.abspath(__file__))
POLL_MS = int(os.environ.get("YTM_POLL_MS", "1000"))
# How long app.signin waits for the app window to quit before giving up.
CLOSE_WAIT_S = float(os.environ.get("YTM_CLOSE_WAIT_S", "10"))


def log(*parts):
    sys.stderr.write("ytm-bridge: " + " ".join(str(p) for p in parts) + "\n")
    sys.stderr.flush()


def xdg(var, default):
    return os.environ.get(var) or os.path.expanduser(default)


# ---------------------------------------------------------------- websocket

class WebSocketClosed(Exception):
    pass


class WebSocket:
    """Minimal RFC 6455 client: text frames, ping/pong, close, fragmentation."""

    def __init__(self, url, timeout=5):
        m = re.match(r"^ws://([^/:]+):(\d+)(/.*)?$", url)
        if not m:
            raise ValueError("bad ws url")
        host, port, path = m.group(1), int(m.group(2)), m.group(3) or "/"
        self.sock = socket.create_connection((host, port), timeout=timeout)
        key = base64.b64encode(secrets.token_bytes(16)).decode()
        req = ("GET %s HTTP/1.1\r\nHost: %s:%d\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
               "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n" % (path, host, port, key))
        self.sock.sendall(req.encode())
        head = b""
        while b"\r\n\r\n" not in head:
            if len(head) >= MAX_HANDSHAKE:
                self._fail("handshake too long")
            chunk = self.sock.recv(min(4096, MAX_HANDSHAKE - len(head)))
            if not chunk:
                self._fail("handshake")
            head += chunk
        head, rest = head.split(b"\r\n\r\n", 1)
        if b" 101" not in head.split(b"\r\n", 1)[0]:
            self._fail("upgrade refused")
        self.buf = rest
        self.sock.settimeout(None)
        self.lock = threading.Lock()

    def _fail(self, why):
        # Drop the socket outright: no close frame, the peer has already
        # shown it cannot be trusted to read one. Reader threads see the
        # exception; the attacher treats it like a browser restart.
        try:
            self.sock.close()
        except OSError:
            pass
        raise WebSocketClosed(why)

    def _read(self, n):
        # Callers bound n (a header or a length-checked payload) before
        # asking, so the buffer never grows past a frame plus one recv.
        while len(self.buf) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                self._fail("eof")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def send_text(self, text):
        data = text.encode()
        n = len(data)
        hdr = bytes([0x81])
        if n < 126:
            hdr += bytes([0x80 | n])
        elif n < 65536:
            hdr += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            hdr += bytes([0x80 | 127]) + struct.pack(">Q", n)
        mask = secrets.token_bytes(4)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
        with self.lock:
            self.sock.sendall(hdr + mask + masked)

    def _send_control(self, opcode, payload=b""):
        mask = secrets.token_bytes(4)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        with self.lock:
            self.sock.sendall(bytes([0x80 | opcode, 0x80 | len(payload)]) + mask + masked)

    def recv_text(self):
        parts = []
        total = 0
        while True:
            b0, b1 = self._read(2)
            fin, opcode = b0 & 0x80, b0 & 0x0F
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            # Both checks happen on the declared length, before a byte of
            # the payload is buffered.
            if n > MAX_FRAME:
                self._fail("frame too large: %d" % n)
            if opcode < 0x8:            # data frame: part of the message
                total += n
                if total > MAX_MESSAGE:
                    self._fail("message too large: %d" % total)
            mask = self._read(4) if b1 & 0x80 else None
            payload = self._read(n)
            if mask:
                payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
            if opcode == 0x8:
                raise WebSocketClosed("close frame")
            if opcode == 0x9:
                self._send_control(0xA, payload)
                continue
            if opcode == 0xA:
                continue
            parts.append(payload)
            if fin:
                return b"".join(parts).decode("utf-8", "replace")

    def close(self):
        try:
            self._send_control(0x8)
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass


# ---------------------------------------------------------------- CDP

class CdpError(Exception):
    pass


class Cdp:
    """One DevTools connection. call() is synchronous; events land in a queue."""

    def __init__(self, ws_url):
        self.ws = WebSocket(ws_url)
        self.pending = {}
        self.plock = threading.Lock()
        self.next_id = 0
        self.events = queue.Queue()
        self.closed = threading.Event()
        threading.Thread(target=self._reader, daemon=True).start()

    def _reader(self):
        try:
            while True:
                msg = json.loads(self.ws.recv_text())
                if "id" in msg:
                    with self.plock:
                        slot = self.pending.pop(msg["id"], None)
                    if slot:
                        slot["msg"] = msg
                        slot["ev"].set()
                else:
                    self.events.put(msg)
        except (WebSocketClosed, OSError, ValueError):
            pass
        finally:
            self.closed.set()
            self.events.put({"method": "__closed"})
            with self.plock:
                for slot in self.pending.values():
                    slot["msg"] = {"error": {"message": "connection closed"}}
                    slot["ev"].set()
                self.pending.clear()

    def call(self, method, params=None, session=None, timeout=10):
        if self.closed.is_set():
            raise CdpError("closed")
        with self.plock:
            self.next_id += 1
            mid = self.next_id
            slot = {"ev": threading.Event(), "msg": None}
            self.pending[mid] = slot
        msg = {"id": mid, "method": method, "params": params or {}}
        if session:
            msg["sessionId"] = session
        self.ws.send_text(json.dumps(msg))
        if not slot["ev"].wait(timeout):
            with self.plock:
                self.pending.pop(mid, None)
            raise CdpError("timeout: " + method)
        reply = slot["msg"]
        if "error" in reply:
            raise CdpError(reply["error"].get("message", "error"))
        return reply.get("result", {})

    def close(self):
        self.ws.close()


# ---------------------------------------------------------------- attacher

class Attacher:
    """Keeps a session attached to the music.youtube.com page, whatever the
    browser does. State is one of no-app / signing-in / attaching /
    signed-out / ready."""

    def __init__(self, profile, on_state, on_track=None, signin_marker=None):
        self.profile = profile
        self.signin_marker = signin_marker
        self.on_state = on_state
        self.on_track = on_track or (lambda v: None)
        self.state = "no-app"
        self.video = ""
        self.nav_gen = 0            # bumps on every full navigation
        self.cdp = None
        self.session = None
        self.target = None
        self.lock = threading.Lock()
        self.page_js = open(os.path.join(HERE, "page.js"), encoding="utf-8").read()
        self._stop = threading.Event()
        self._port_seen = None
        threading.Thread(target=self._loop, daemon=True).start()

    def _set(self, state):
        if state == self.state:
            return
        self.state = state
        log("state", state)
        self.on_state(state)

    def stop(self):
        self._stop.set()
        self._drop()

    def _port_file(self):
        return os.path.join(self.profile, "DevToolsActivePort")

    # Chromium's profile lock is a symlink to "<hostname>-<pid>"; that pid is
    # what its MPRIS bus name ends with, which is how the shell tells this
    # window's player apart from the user's everyday browser.
    def browser_pid(self):
        try:
            target = os.readlink(os.path.join(self.profile, "SingletonLock"))
            return int(target.rsplit("-", 1)[1])
        except (OSError, ValueError, IndexError):
            return 0

    def browser_alive(self):
        pid = self.browser_pid()
        if not pid:
            return False
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            pass
        return True

    def signing_in(self):
        """True while `ytm-app --signin` (or the bridge handing over to it)
        holds the marker: the plain sign-in window is up and nothing can be
        attached, which is not the same as "not open"."""
        if not self.signin_marker:
            return False
        try:
            with open(self.signin_marker, encoding="utf-8") as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
        except (OSError, ValueError):
            return False
        return True

    def close_browser(self, wait_s):
        """Ask our browser to quit over DevTools (a clean exit, so cookies are
        flushed), then wait for its profile lock to go."""
        with self.lock:
            cdp = self.cdp
        if cdp and not cdp.closed.is_set():
            try:
                cdp.call("Browser.close", timeout=5)
            except CdpError:
                pass
        deadline = time.time() + wait_s
        while time.time() < deadline and self.browser_alive():
            time.sleep(0.1)
        return not self.browser_alive()

    def _read_port(self):
        try:
            with open(self._port_file(), encoding="utf-8") as f:
                lines = f.read().split("\n")
            return int(lines[0].strip()), lines[1].strip() if len(lines) > 1 else ""
        except (OSError, ValueError, IndexError):
            return None

    def _drop(self):
        with self.lock:
            cdp, self.cdp, self.session, self.target = self.cdp, None, None, None
        if cdp:
            cdp.close()

    def _loop(self):
        while not self._stop.is_set():
            try:
                if self.cdp is None or self.cdp.closed.is_set():
                    self._drop()
                    if not self._try_attach():
                        self._set("signing-in" if self.signing_in() else "no-app")
                        time.sleep(POLL_MS / 1000.0)
                        continue
                self._pump_events()
            except Exception as e:  # never let the loop die
                log("loop error", repr(e))
                self._drop()
                self._set("no-app")
                time.sleep(POLL_MS / 1000.0)

    def _try_attach(self):
        port = self._read_port()
        if not port:
            return False
        self._set("attaching")
        try:
            with urllib.request.urlopen("http://127.0.0.1:%d/json/version" % port[0], timeout=3) as r:
                ws_url = json.loads(r.read(MAX_VERSION_JSON))["webSocketDebuggerUrl"]
            cdp = Cdp(ws_url)
        except (OSError, ValueError, KeyError, WebSocketClosed):
            # Stale port file from a browser that is gone.
            return False
        try:
            cdp.call("Target.setDiscoverTargets", {"discover": True})
            if not self._attach_page(cdp):
                # Browser is up but the page is not (yet). Keep the connection
                # and wait for Target.targetCreated.
                with self.lock:
                    self.cdp = cdp
                return True
        except CdpError as e:
            log("attach failed", e)
            cdp.close()
            return False
        return True

    def _attach_page(self, cdp):
        infos = cdp.call("Target.getTargets").get("targetInfos", [])
        page = None
        for t in infos:
            if t.get("type") == "page" and str(t.get("url", "")).startswith(PAGE_URL_PREFIX):
                page = t
                break
        if not page:
            return False
        session = cdp.call("Target.attachToTarget", {"targetId": page["targetId"], "flatten": True})["sessionId"]
        cdp.call("Runtime.enable", session=session)
        cdp.call("Page.enable", session=session)
        cdp.call("Runtime.evaluate", {"expression": self.page_js, "returnByValue": True}, session=session)
        with self.lock:
            self.cdp, self.session, self.target = cdp, session, page["targetId"]
        self._refresh_login()
        return True

    def _refresh_login(self):
        try:
            st = self.page_call("state", {})
        except (CdpError, PageError) as e:
            log("login check failed", e)
            self._set("attaching")
            return
        self._set("ready" if st and st.get("loggedIn") else "signed-out")
        self._note_video(st)

    def _note_video(self, st):
        v = str((st or {}).get("video") or "")
        if v and not VALID_ID.match(v):
            v = ""
        if v != self.video:
            self.video = v
            self.on_track(v)

    def _pump_events(self):
        cdp = self.cdp
        last_login = time.time()
        while not self._stop.is_set() and cdp is self.cdp and not cdp.closed.is_set():
            try:
                ev = cdp.events.get(timeout=1.0)
            except queue.Empty:
                # While signed out, re-check now and then: the user is typing
                # a password in that window and nothing else tells us. While
                # ready, the same call is how track changes are noticed —
                # MPRIS carries no video id.
                if self.state in ("signed-out", "ready") and time.time() - last_login > 2:
                    self._refresh_login()
                    last_login = time.time()
                continue
            m = ev.get("method")
            p = ev.get("params", {}) or {}
            if m == "__closed":
                return
            if m in ("Target.targetDestroyed", "Target.detachedFromTarget") and p.get("targetId") == self.target:
                with self.lock:
                    self.session, self.target = None, None
                self._set("no-app")
                # The browser process may still be alive with no page; keep
                # polling for a new one on this connection.
                self._attach_page(cdp)
            elif m == "Target.targetCreated" and self.session is None:
                info = p.get("targetInfo", {})
                if info.get("type") == "page" and str(info.get("url", "")).startswith(PAGE_URL_PREFIX):
                    self._attach_page(cdp)
            elif m == "Page.frameNavigated" and ev.get("sessionId") == self.session:
                # A full navigation drops window.__ytm; reinstall it.
                if not p.get("frame", {}).get("parentId"):
                    self.nav_gen += 1
                    self._global_id = None
                    try:
                        cdp.call("Runtime.evaluate", {"expression": self.page_js, "returnByValue": True},
                                 session=self.session)
                    except CdpError:
                        pass
                    self._refresh_login()

    def page_call(self, op, arg, timeout=20):
        with self.lock:
            cdp, session = self.cdp, self.session
        if not cdp or not session:
            raise CdpError("no-app")
        return self._call_fn(cdp, session, op, arg, timeout)

    def _call_fn(self, cdp, session, op, arg, timeout):
        # callFunctionOn needs a target object; the global object is obtained
        # once per session and cached.
        gid = getattr(self, "_global_id", None)
        if gid is None or getattr(self, "_global_session", None) != session:
            res = cdp.call("Runtime.evaluate", {"expression": "window", "returnByValue": False}, session=session)
            gid = res.get("result", {}).get("objectId")
            self._global_id, self._global_session = gid, session
        params = {
            "functionDeclaration": "function(op, arg) { return window.__ytm(op, arg) }",
            "arguments": [{"value": op}, {"value": arg}],
            "awaitPromise": True,
            "returnByValue": True,
        }
        if gid:
            params["objectId"] = gid
        r = cdp.call("Runtime.callFunctionOn", params, session=session, timeout=timeout)
        if "exceptionDetails" in r:
            text = r["exceptionDetails"].get("text", "")
            exc = r["exceptionDetails"].get("exception", {}).get("description", "")
            raise PageError((exc or text or "page exception").split("\n")[0][:200])
        return r.get("result", {}).get("value")


class PageError(Exception):
    pass


# ---------------------------------------------------------------- ops

class BadRequest(Exception):
    pass


class BadId(Exception):
    pass


def need_id(arg, key, optional=False):
    v = arg.get(key)
    if v is None or v == "":
        if optional:
            return None
        raise BadId(key)
    if not isinstance(v, str) or not VALID_ID.match(v):
        raise BadId(key)
    return v


class Ops:
    """One method per protocol op. Validates, then forwards to the page."""

    def __init__(self, attacher, launcher, cache_dir):
        self.att = attacher
        self.launcher = launcher
        self.cache_dir = cache_dir
        self.launch_lock = threading.Lock()
        self.last_launch = 0.0

    # -- unauthenticated --------------------------------------------
    def op_state(self, arg):
        return {"state": self.att.state, "pid": self.att.browser_pid(), "video": self.att.video}

    def op_app_launch(self, arg):
        with self.launch_lock:
            if time.time() - self.last_launch < 5:
                return {"launched": False, "reason": "recent"}
            self.last_launch = time.time()
        cmd = [self.launcher]
        browser = arg.get("browser")
        if browser:
            if not re.match(r"^[A-Za-z0-9._-]+$", str(browser)):
                raise BadRequest("browser")
            cmd += ["--browser", str(browser)]
        try:
            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as e:
            raise BadRequest("launcher: %s" % e)
        return {"launched": True}

    def op_app_signin(self, arg):
        """Sign in without the debug port. Google refuses to sign in a browser
        under remote control ("This browser or app may not be secure"), so
        close our app window and hand over to `ytm-app --signin`, which opens a
        plain window on the same profile, waits for the user to close it and
        launches the app again."""
        marker = self.att.signin_marker
        if not marker:
            raise BadRequest("no sign-in marker")
        with self.launch_lock:
            if time.time() - self.last_launch < 5:
                return {"started": False, "reason": "recent"}
            self.last_launch = time.time()
        cmd = [self.launcher, "--signin", "--marker", marker]
        browser = arg.get("browser")
        if browser:
            if not re.match(r"^[A-Za-z0-9._-]+$", str(browser)):
                raise BadRequest("browser")
            cmd += ["--browser", str(browser)]

        def clear():
            try:
                os.unlink(marker)
            except OSError:
                pass
        # Hold the marker ourselves until the launcher takes it over, so the
        # state reads "signing-in" rather than "no-app" in between.
        with open(marker, "w", encoding="utf-8") as f:
            f.write("%d\n" % os.getpid())
        if not self.att.close_browser(CLOSE_WAIT_S):
            clear()
            return {"started": False, "reason": "busy"}
        try:
            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as e:
            clear()
            raise BadRequest("launcher: %s" % e)
        return {"started": True}

    # -- page-backed ---------------------------------------------------
    def _page(self, op, arg):
        if self.att.state == "signed-out":
            raise SignedOut()
        if self.att.state != "ready":
            raise NoApp()
        return self.att.page_call(op, arg)

    def op_library_playlists(self, arg):
        try:
            data = self._page("library.playlists", {})
        except (CdpError, PageError):
            cached = self._read_cache("library.json")
            if cached is None:
                raise
            return {"data": cached, "cached": True}
        self._write_cache("library.json", data)
        return {"data": data}

    def op_home(self, arg):
        try:
            data = self._page("home", {})
        except (CdpError, PageError):
            cached = self._read_cache("home.json")
            if cached is None:
                raise
            return {"data": cached, "cached": True}
        self._write_cache("home.json", data)
        return {"data": data}

    def op_playlist_items(self, arg):
        return {"data": self._page("playlist.items", {"list": need_id(arg, "list")})}

    def op_play(self, arg):
        a = {"list": need_id(arg, "list", optional=True), "video": need_id(arg, "video", optional=True)}
        if not a["list"] and not a["video"]:
            raise BadId("list")
        idx = arg.get("index")
        if idx is not None:
            if not isinstance(idx, int) or idx < 0 or idx > 10000:
                raise BadRequest("index")
            a["index"] = idx
        a["shuffle"] = bool(arg.get("shuffle", False))
        gen = self.att.nav_gen
        data = self._page("play", a)
        if a["shuffle"]:
            # The page reloads on play; wait for it to come back, then turn
            # shuffle on in the player bar (there is no URL parameter for it).
            deadline = time.time() + 12
            while time.time() < deadline and (self.att.nav_gen == gen or self.att.state != "ready"):
                time.sleep(0.2)
            for _ in range(10):
                try:
                    if self._page("player.shuffle", {}).get("shuffled"):
                        break
                except (CdpError, PageError, NoApp, SignedOut):
                    pass
                time.sleep(0.5)
        return {"data": data}

    def op_now(self, arg):
        return {"data": self._page("now", {})}

    def op_queue(self, arg):
        return {"data": self._page("queue", {})}

    def op_queue_jump(self, arg):
        idx = arg.get("index")
        if not isinstance(idx, int) or idx < 0 or idx > 10000:
            raise BadRequest("index")
        return {"data": self._page("queue.jump", {"index": idx})}

    def op_like(self, arg):
        return {"data": self._page("like", {"video": need_id(arg, "video")})}

    def op_dislike(self, arg):
        return {"data": self._page("dislike", {"video": need_id(arg, "video")})}

    def op_unlike(self, arg):
        return {"data": self._page("unlike", {"video": need_id(arg, "video")})}

    def op_radio(self, arg):
        return {"data": self._page("radio", {"video": need_id(arg, "video")})}

    def op_lyrics(self, arg):
        return {"data": self._page("lyrics", {"video": need_id(arg, "video")})}

    def op_playlist_add(self, arg):
        return {"data": self._page("playlist.add", {"video": need_id(arg, "video"), "list": need_id(arg, "list")})}

    def op_search(self, arg):
        q = arg.get("q")
        if not isinstance(q, str) or not q.strip() or len(q) > MAX_QUERY:
            raise BadRequest("q")
        return {"data": self._page("search", {"q": q})}

    def op_volume_get(self, arg):
        return {"data": self._page("volume.get", {})}

    def op_volume_set(self, arg):
        v = arg.get("volume")
        if not isinstance(v, int) or isinstance(v, bool) or v < 0 or v > 100:
            raise BadRequest("volume")
        return {"data": self._page("volume.set", {"volume": v})}

    def op_repeat_get(self, arg):
        return {"data": self._page("repeat.get", {})}

    def op_repeat_set(self, arg):
        mode = arg.get("mode")
        if mode not in ("NONE", "ALL", "ONE"):
            raise BadRequest("mode")
        return {"data": self._page("repeat.set", {"mode": mode})}

    def op_shuffle_get(self, arg):
        return {"data": self._page("shuffle.get", {})}

    def op_shuffle_set(self, arg):
        on = arg.get("on")
        if not isinstance(on, bool):
            raise BadRequest("on")
        return {"data": self._page("shuffle.set", {"on": on})}

    def op_art(self, arg):
        """Download an artwork URL into the cache and return its path, for
        notify-send, which needs a file. Only https://*.googleusercontent.com
        and https://*.ytimg.com are fetched."""
        url = arg.get("url")
        if not isinstance(url, str) or not re.match(
                r"^https://([a-z0-9-]+\.)*(googleusercontent\.com|ytimg\.com|ggpht\.com|gstatic\.com)/[^\s]{1,1024}$", url):
            raise BadRequest("url")
        os.makedirs(self.cache_dir, exist_ok=True)
        import hashlib
        path = os.path.join(self.cache_dir, "art-" + hashlib.sha1(url.encode()).hexdigest()[:16] + ".jpg")
        if not os.path.exists(path):
            try:
                with urllib.request.urlopen(url, timeout=10) as r:
                    data = r.read(2 * 1024 * 1024)
                with open(path + ".tmp", "wb") as f:
                    f.write(data)
                os.replace(path + ".tmp", path)
            except (OSError, ValueError) as e:
                raise BadRequest("fetch: %s" % e)
        return {"path": path}

    # -- cache -----------------------------------------------------------
    def _read_cache(self, name):
        try:
            with open(os.path.join(self.cache_dir, name), encoding="utf-8") as f:
                return json.load(f)
        except (OSError, ValueError):
            return None

    def _write_cache(self, name, data):
        try:
            os.makedirs(self.cache_dir, exist_ok=True)
            blob = json.dumps(data)
            if len(blob) > 1024 * 1024:
                return
            with open(os.path.join(self.cache_dir, name + ".tmp"), "w", encoding="utf-8") as f:
                f.write(blob)
            os.replace(os.path.join(self.cache_dir, name + ".tmp"), os.path.join(self.cache_dir, name))
        except OSError:
            pass

    def dispatch(self, op, arg):
        fn = getattr(self, "op_" + str(op).replace(".", "_"), None) if re.match(r"^[a-z][a-z.]{0,30}$", str(op)) else None
        if fn is None:
            raise BadRequest("op")
        return fn(arg)


class SignedOut(Exception):
    pass


class NoApp(Exception):
    pass


ERROR_CODES = {
    BadRequest: "bad-request",
    BadId: "bad-id",
    SignedOut: "signed-out",
    NoApp: "no-app",
    PageError: "page-error",
}


def run_request(ops, msg):
    if not isinstance(msg, dict):
        return {"ok": False, "error": "bad-request"}
    rid = msg.get("id")
    op = msg.get("op")
    try:
        result = ops.dispatch(op, msg)
        out = {"id": rid, "ok": True}
        out.update(result or {})
        return out
    except tuple(ERROR_CODES) as e:
        return {"id": rid, "ok": False, "error": ERROR_CODES[type(e)]}
    except CdpError as e:
        code = "no-app" if str(e) in ("no-app", "closed") else "timeout" if str(e).startswith("timeout") else "page-error"
        return {"id": rid, "ok": False, "error": code}
    except Exception as e:  # a bug must not kill the client's connection
        log("op", op, "crashed:", repr(e))
        return {"id": rid, "ok": False, "error": "page-error"}


# ---------------------------------------------------------------- server

class Server:
    def __init__(self, path, ops):
        self.path = path
        self.ops = ops
        self.clients = set()
        self.clock = threading.Lock()
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        old = os.umask(0o177)
        try:
            self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.sock.bind(path)
        finally:
            os.umask(old)
        os.chmod(path, 0o600)
        self.sock.listen(8)

    def serve(self):
        while True:
            try:
                conn, _ = self.sock.accept()
            except OSError:
                return
            threading.Thread(target=self._client, args=(conn,), daemon=True).start()

    def broadcast(self, obj):
        line = (json.dumps(obj) + "\n").encode()
        with self.clock:
            dead = []
            for c in self.clients:
                try:
                    c.sendall(line)
                except OSError:
                    dead.append(c)
            for c in dead:
                self.clients.discard(c)

    def _client(self, conn):
        with self.clock:
            self.clients.add(conn)
        buf = b""
        try:
            while True:
                chunk = conn.recv(65536)
                if not chunk:
                    break
                buf += chunk
                if len(buf) > 1024 * 1024:
                    break
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    if not line.strip():
                        continue
                    try:
                        msg = json.loads(line.decode("utf-8", "replace"))
                    except ValueError:
                        msg = None
                    reply = run_request(self.ops, msg)
                    conn.sendall((json.dumps(reply) + "\n").encode())
        except OSError:
            pass
        finally:
            with self.clock:
                self.clients.discard(conn)
            try:
                conn.close()
            except OSError:
                pass

    def close(self):
        try:
            self.sock.close()
        finally:
            try:
                os.unlink(self.path)
            except OSError:
                pass


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--socket", default=os.path.join(xdg("XDG_RUNTIME_DIR", "/tmp"), "tiertek.ytm.sock"))
    ap.add_argument("--profile", default=os.path.join(xdg("XDG_DATA_HOME", "~/.local/share"), "tiertek.ytm", "profile"))
    ap.add_argument("--cache", default=os.path.join(xdg("XDG_CACHE_HOME", "~/.cache"), "tiertek.ytm"))
    ap.add_argument("--launcher", default=os.path.join(HERE, "ytm-app"))
    ap.add_argument("--once", nargs="+", metavar=("OP", "JSON"))
    ap.add_argument("--check-id")
    args = ap.parse_args()

    if args.check_id is not None:
        sys.exit(0 if VALID_ID.match(args.check_id) else 1)

    if args.once:
        att = Attacher(args.profile, lambda s: None)
        ops = Ops(att, args.launcher, args.cache)
        deadline = time.time() + 15
        while att.state in ("no-app", "attaching") and time.time() < deadline:
            time.sleep(0.2)
        msg = {"id": 1, "op": args.once[0]}
        if len(args.once) > 1:
            msg.update(json.loads(args.once[1]))
        print(json.dumps(run_request(ops, msg), indent=1))
        att.stop()
        return

    server_ref = {}

    def on_state(state):
        s = server_ref.get("s")
        if s:
            s.broadcast({"ev": "state", "state": state, "pid": att.browser_pid()})

    def on_track(video):
        s = server_ref.get("s")
        if s:
            s.broadcast({"ev": "track", "video": video})

    att = Attacher(args.profile, on_state, on_track, signin_marker=args.socket + ".signin")
    ops = Ops(att, args.launcher, args.cache)
    server = Server(args.socket, ops)
    server_ref["s"] = server

    def stop(*_):
        att.stop()
        server.close()
        os._exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    log("listening on", args.socket)
    server.serve()


if __name__ == "__main__":
    main()
