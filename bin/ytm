#!/usr/bin/env bash
# Keybinding entry point: forwards one verb to the running shell widget.
#   ytm toggle | open | close | playPause | next | prev | like | reveal | hide | launch
#   ytm quit | volumeUp | volumeDown | repeat | shuffle | save
#   ytm view player|playlists|queue|history|lyrics|search
# `close` closes the panel; `quit` closes the YouTube Music window itself (to
# free its memory; `launch` brings it back, still signed in).
# The verb list is closed on purpose: this script is what a keybind runs.
set -euo pipefail
verb="${1:-toggle}"
case "$verb" in
  toggle|open|close|playPause|next|prev|like|reveal|hide|launch|quit|volumeUp|volumeDown|repeat|shuffle|save)
    exec qs -p /usr/share/omarchy/shell ipc call tiertek.ytm "$verb" ;;
  view)
    case "${2:-}" in
      player|playlists|queue|history|lyrics|search) exec qs -p /usr/share/omarchy/shell ipc call tiertek.ytm view "$2" ;;
      *) echo "ytm: unknown view: ${2:-}" >&2; exit 2 ;;
    esac ;;
  *) echo "ytm: unknown verb: $verb" >&2; exit 2 ;;
esac
